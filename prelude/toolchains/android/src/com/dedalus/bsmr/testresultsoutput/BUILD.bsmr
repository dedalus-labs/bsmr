load("@prelude//toolchains/android/tools:build_rules.bzl", "bsmr_java_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_java_library(
    name = "testresultsoutput",
    srcs = [
        "TestResultsOutputEvent.java",
        "TestResultsOutputSender.java",
    ],
    # @oss-disable[end= ]: source = "8",
    # @oss-disable[end= ]: target = "8",
    source = "11", # @oss-enable
    target = "11", # @oss-enable
    tests = [
        "prelude//toolchains/android/test/com/dedalus/bsmr/testresultsoutput:testresultsoutput",
    ],
    visibility = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/testrunner:instrumentation",
        "prelude//toolchains/android/src/com/dedalus/bsmr/testrunner:junit",
        "prelude//toolchains/android/src/com/dedalus/bsmr/testrunner:timeout",
        "prelude//toolchains/android/test/com/dedalus/bsmr/testresultsoutput:testresultsoutput",
        "prelude//toolchains/android/test/com/dedalus/bsmr/testrunner:testrunner",
        "prelude//toolchains/android/test/com/dedalus/bsmr/testrunner:tpx_timeout_buffer_manager_test",
    ],
    deps = [
        "prelude//toolchains/android/third-party:jackson-core",
    ],
)
