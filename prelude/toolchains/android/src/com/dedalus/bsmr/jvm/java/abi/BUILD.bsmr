load("@prelude//toolchains/android/tools:build_rules.bzl", "bsmr_java_binary", "bsmr_java_library", "bsmr_prebuilt_artifact", "bsmr_prebuilt_jar")
load("@prelude//toolchains/android/tools/build_rules:fb_native.bzl", "fb_native")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_java_library(
    name = "abi",
    srcs = glob(
        ["*.java"],
        exclude = [
            "ApiStubber.java",
        ],
    ),
    tests = [
        "prelude//toolchains/android/test/com/dedalus/bsmr/jvm/java/abi:abi",
    ],
    versioned_java_srcs = True,
    visibility = [
        "prelude//toolchains/android/meta_only/src/com/dedalus/bsmr/jvm/remote_worker/...",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java:steps",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java:support",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/stepsbuilder/javacd/main:command_lib",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/cd/workertool:command_lib",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/cd/workertool/postexecutors:postexecutors",
        "prelude//toolchains/android/test/com/dedalus/bsmr/jvm/java/abi/...",
        "prelude//toolchains/android/test/com/dedalus/bsmr/jvm/kotlin/cd/workertool/postexecutors:postexecutors",
    ],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/cd/resources/proto:javacd-model",
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/filesystem/impl:utils",
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/pathformat:pathformat",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/abi/kotlin:kotlin",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/abi/source/api:api",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/lang/extra:extra",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/lang/model:model",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/plugin/api:api",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util:util",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/function:function",
        "prelude//toolchains/android/third-party:asm",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:jsr305",
    ],
    exported_deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/zip:zip",
    ],
)

fb_native.alias(
    name = "api-stubber",
    actual = ":api-stubber_prebuilt",
    visibility = ["PUBLIC"],
)

bsmr_java_binary(
    name = "api-stubber-main",
    main_class = "com.dedalus.bsmr.jvm.java.abi.ApiStubber",
    deps = [
        ":lib-api-stubber",
    ],
)

# This is a prebuilt jar so that it can be part of the bsmr bootstrap toolchain.
bsmr_prebuilt_jar(
    name = "api-stubber_prebuilt",
    _dex_toolchain = "toolchains//:empty_dex",
    binary_jar = ":api-stubber-main_jar.jar",
    is_executable = True,
    should_generate_snapshot = False,
    visibility = ["PUBLIC"],
)

# To rebuild the jar and upload it to CAS, do:
# bsmr build prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/abi:api-stubber-main --show-simple-output | xargs frecli --use-case android_build_infra_tools cas upload-blob
bsmr_prebuilt_artifact(
    name = "api-stubber-main_jar.jar",
    # @oss-disable[end= ]: cas_digest = "3ea4825239cf3cd3afc0a244c6a87c9270c7c0d2ff0ffe6bf2c4ef9292f6fc01:27183911",
    oss_sha1 = "59b1fcca9ec544a86df64fb544fce3bfcee7eaa8",
    oss_url = "https://github.com/facebook/buck2/releases/download/androidToolchain%2F2025-04-03/api-stubber-main_jar.jar",
)

bsmr_java_library(
    name = "lib-api-stubber",
    srcs = ["ApiStubber.java"],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/filesystems:filesystems",
        ":abi",
    ],
)
