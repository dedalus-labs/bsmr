load("@prelude//toolchains/android/tools:build_rules.bzl", "bsmr_java_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_java_library(
    name = "serialization",
    srcs = glob(
        ["*.java"],
        exclude = ["SerializationUtil.java"],
    ),
    visibility = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/...",
        "prelude//toolchains/android/test/com/dedalus/bsmr/jvm/...",
    ],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/cd/resources/proto:cd-model",
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/filesystems:filesystems",
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/filesystem:filesystem",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/environment:environment",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
    ],
)

bsmr_java_library(
    name = "util",
    srcs = ["SerializationUtil.java"],
    visibility = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd/serialization/...",
    ],
    deps = [
        "prelude//toolchains/android/third-party:infer-annotations",
    ],
)
