load(
    "@prelude//toolchains/android/tools:build_rules.bzl",
    "bsmr_java_library",
)
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_java_library(
    name = "cd",
    srcs = glob(["*.java"]),
    visibility = [
        "prelude//toolchains/android/meta_only/src/com/dedalus/bsmr/jvm/remote_worker/...",
        "prelude//toolchains/android/src/com/dedalus/bsmr/...",
        "prelude//toolchains/android/test/com/dedalus/bsmr/...",
    ],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/cd/resources/proto:cd-model",
        "prelude//toolchains/android/src/com/dedalus/bsmr/cd/resources/proto:javacd-model",
        "prelude//toolchains/android/src/com/dedalus/bsmr/cd/resources/proto:kotlincd-model",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd/command/kotlin:command",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd/serialization:serialization",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd/serialization/java:java",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd/workertool:workertool",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java:support",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/abi/source/api:api",
        "prelude//toolchains/android/src/com/dedalus/bsmr/step/isolatedsteps/java:java",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/json:json",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:jsr305",
        "prelude//toolchains/android/third-party:kotlin-annotations",
    ],
)
