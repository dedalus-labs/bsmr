        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/core:core",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java:support",
        "prelude//toolchains/android/third-party:guava",
        ":support",
    ],
    exported_deps = [
