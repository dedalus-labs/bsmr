    labels = ["codegen_rule"],
    visibility = ["PUBLIC"],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/filesystems:filesystems",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java:support",
        "prelude//toolchains/android/third-party:guava",
        ":language-version",
    ],
)

bsmr_kotlin_library(
    name = "command",
    srcs = ["BuildKotlinCommand.kt"],
    tests = [
        "prelude//toolchains/android/test/com/dedalus/bsmr/jvm/kotlin:kotlin",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/cd/resources/proto:javacd-model",
        "prelude//toolchains/android/src/com/dedalus/bsmr/cd/resources/proto:kotlincd-model",
