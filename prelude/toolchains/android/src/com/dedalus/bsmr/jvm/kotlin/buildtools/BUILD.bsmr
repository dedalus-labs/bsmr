load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_kotlin_library(
    name = "buildtools",
    srcs = glob(["**/*.kt"]),
    extra_kotlinc_arguments = ["-Xopt-in=kotlin.ExperimentalStdlibApi"],
    tests = [
        "prelude//toolchains/android/test/com/dedalus/bsmr/jvm/kotlin/buildtools:buildtools",
    ],
    visibility = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/...",
        "prelude//toolchains/android/test/com/dedalus/bsmr/jvm/kotlin/...",
    ],
    deps = [
        # @oss-disable[end= ]: "upstream//fbandroid/java/com/facebook/kotlin/compilercompat:compilercompat",
        "prelude//toolchains/android/src/com/dedalus/bsmr/cd/resources/proto:javacd-model",
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/build/execution/context:context",
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/filesystems:filesystems",
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/util/log:log",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java:support",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/javax:javax",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/cd/analytics:analytics",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/kotlinc:kotlinc",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/kotlinc/incremental:incremental",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:kotlin-build-tools-api",
    ],
)
