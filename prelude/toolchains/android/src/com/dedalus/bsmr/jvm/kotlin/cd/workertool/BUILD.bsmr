load("@prelude//:is_full_meta_repo.bzl", "is_full_meta_repo")
load("@prelude//toolchains/android/tools:build_rules.bzl", "bsmr_java_binary", "bsmr_java_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_java_library(
    name = "command_lib",
    srcs = [
        "KotlinCDCommand.java",
    ],
    visibility = [
        "prelude//toolchains/android/meta_only/src/com/dedalus/bsmr/jvm/remote_worker/...",
    ],
    runtime_deps = select({
        "DEFAULT": [
            "prelude//toolchains/android/meta_only/src/com/dedalus/bsmr/jvm/kotlin/cd/logger/scribe:scribe",
        ]
        if is_full_meta_repo()
        else [
            "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/cd/analytics/logger/noop:noop",
        ],
        "config//os/constraints:windows": [
            "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/cd/analytics/logger/noop:noop",
        ],
    }),
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/cd/resources/proto:kotlincd-model",
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/filesystems:filesystems",
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/util/log:log",
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/file:file",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd:cd",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd/command/kotlin:command",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd/serialization/kotlin:kotlin",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java:support",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/abi:abi",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin:steps",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/cd/analytics:analytics",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/cd/analytics/logger:logger",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/cd/workertool/postexecutors:postexecutors",
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:jsr305",
        "prelude//toolchains/android/third-party:protobuf-util",
    ],
)

bsmr_java_library(
    name = "main_lib",
    srcs = [
        "KotlinCDMain.java",
    ],
    visibility = [
        "PUBLIC",
    ],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/util/log:log",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd:cd",
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:gson",
        "prelude//toolchains/android/third-party:guava",
        ":command_lib",
    ],
)

bsmr_java_library(
    name = "grpc_worker_tool_lib",
    srcs = ["KotlinCDGrpcWorkerToolMain.java"],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/util/log:log",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd:cd",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd/workertool:workertool",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd/workertool/grpc:workertool_grpc",
        "prelude//toolchains/android/src/com/dedalus/bsmr/workertool/resources/proto:worker-model",
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:guava",
        ":command_lib",
    ],
)

bsmr_java_binary(
    name = "kotlincd_tool-main",
    main_class = "com.dedalus.bsmr.jvm.kotlin.cd.workertool.KotlinCDMain",
    visibility = [
        "PUBLIC",
    ],
    deps = [
        ":main_lib",
    ],
)

bsmr_java_binary(
    name = "kotlincd_tool",
    main_class = "com.dedalus.bsmr.jvm.kotlin.cd.workertool.KotlinCDGrpcWorkerToolMain",
    visibility = [
        "PUBLIC",
    ],
    deps = [
        ":grpc_worker_tool_lib",
    ],
)
