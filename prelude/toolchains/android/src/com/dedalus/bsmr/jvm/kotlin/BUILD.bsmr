        "prelude//toolchains/android/src/com/dedalus/bsmr/util/json:json",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd/command/kotlin:language-version",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/abtesting:abtesting",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/abtesting/ksic:ksic",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/ksp/incremental:incremental",
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/filesystems:filesystems",
    ],
)
