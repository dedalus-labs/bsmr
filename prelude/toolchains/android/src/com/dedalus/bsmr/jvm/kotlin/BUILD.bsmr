load("@prelude//toolchains/android/tools:build_rules.bzl", "bsmr_kotlin_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_kotlin_library(
    name = "steps",
    srcs = glob([
        "*.java",
        "**/*.kt",
    ]),
    tests = [
        "prelude//toolchains/android/test/com/dedalus/bsmr/jvm/kotlin:kotlin",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/cd/resources/proto:javacd-model",
        "prelude//toolchains/android/src/com/dedalus/bsmr/cd/resources/proto:kotlincd-model",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/core:core",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd/serialization:serialization",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd/serialization/java:java",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd/serialization/kotlin:kotlin",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java:steps",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java:support",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/javax:javax",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/cd/command/kotlin:command",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/buildtools:buildtools",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/cd/analytics:analytics",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/buildtools/snapshot:cp_snapshot_generator_lib",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/kotlinc:kotlinc",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/kotlinc/incremental:incremental",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/compilerplugins/usedclasses:usedclasses",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/ksp:ksp",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/plugin:plugin-loader",
        "prelude//toolchains/android/src/com/dedalus/bsmr/step/isolatedsteps/java:java",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:jsr305",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/abi/source/api:api",
