load("@prelude//toolchains/android/tools:build_rules.bzl", "bsmr_java_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_java_library(
    name = "workertool",
    srcs = glob(["*.java"]),
    visibility = [
        "prelude//toolchains/android/meta_only/src/com/dedalus/bsmr/jvm/remote_worker/...",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/...",
        "prelude//toolchains/android/test/com/dedalus/bsmr/jvm/...",
    ],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/step/isolatedsteps:isolatedsteps",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/environment:environment",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/perf:perf",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/unit:unit",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:jsr305",
        "prelude//toolchains/android/third-party:kotlin-annotations",
    ],
)
