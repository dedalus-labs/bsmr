load(
    "@prelude//toolchains/android/tools:build_rules.bzl",
    "bsmr_java_binary",
    "bsmr_java_library",
    "bsmr_kotlin_library",
    "bsmr_prebuilt_artifact",
    "bsmr_prebuilt_jar",
)
load("@prelude//toolchains/android/tools/build_rules:fb_native.bzl", "fb_native")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

JAR_BUILDER_MAIN_SRCS = [
    "JarBuilderMain.java",
]

ZIP_SCRUBBER_SRCS = [
    "ZipScrubber.java",
    "ZipConstants.java",
]

bsmr_kotlin_library(
    name = "zip",
    srcs = glob(
        [
            "*.java",
            "*.kt",
        ],
        exclude = JAR_BUILDER_MAIN_SRCS + ZIP_SCRUBBER_SRCS,
    ),
    tests = [
        "prelude//toolchains/android/test/com/dedalus/bsmr/util/zip:zip",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/util/log:log",
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/file:file",
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/filesystem:filesystem",
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/filesystem/impl:utils",
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/pathformat:pathformat",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/function:function",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/io:io",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/unarchive:unarchive",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:jsr305",
    ],
    exported_deps = [
        ":zip_scrubber_lib",
    ],
)

bsmr_java_library(
    name = "zip_scrubber_lib",
    srcs = ZIP_SCRUBBER_SRCS,
    visibility = ["PUBLIC"],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/util:util",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/nio:nio",
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:guava",
    ],
)

fb_native.alias(
    name = "zip_scrubber",
    actual = ":zip_scrubber_prebuilt",
    visibility = ["PUBLIC"],
)

# This is a prebuilt jar so that it can be part of the bsmr bootstrap toolchain.
# To rebuild the jar, do:
# `bsmr build prelude//toolchains/android/src/com/dedalus/bsmr/util/zip:zip_scrubber_main --out xplat/toolchains/android/sdk/src/com/dedalus/bsmr/util/zip/zip_scrubber_main.jar`
bsmr_prebuilt_jar(
    name = "zip_scrubber_prebuilt",
    _dex_toolchain = "toolchains//:empty_dex",
    binary_jar = ":zip_scrubber_main.jar",
    should_generate_snapshot = False,
    visibility = ["PUBLIC"],
)

# To rebuild the jar and upload it to CAS, do:
# bsmr build prelude//toolchains/android/src/com/dedalus/bsmr/util/zip:zip_scrubber_main --show-simple-output | xargs frecli --use-case android_build_infra_tools cas upload-blob
bsmr_prebuilt_artifact(
    name = "zip_scrubber_main.jar",
    # @oss-disable[end= ]: cas_digest = "9cec24a193a236fc5acdaff4fae66769f22c56af19c1e9204affad545d0ec7ab:10388458",
    oss_sha1 = "23c85d8db2958ad502c1cd1eb3bbcd1342c37c7d",
    oss_url = "https://github.com/facebook/buck2/releases/download/androidToolchain%2F2025-04-03/zip_scrubber_main.jar",
)

bsmr_java_binary(
    name = "zip_scrubber_main",
    main_class = "com.dedalus.bsmr.util.zip.ZipScrubber",
    visibility = ["PUBLIC"],
    deps = [":zip_scrubber_lib"],
)

bsmr_java_library(
    name = "jar_builder_main_lib",
    srcs = JAR_BUILDER_MAIN_SRCS,
    visibility = ["PUBLIC"],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/filesystems:filesystems",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java:remove_classes_patterns_matcher",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util:util",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/function:function",
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:guava",
        ":zip",
    ],
)

fb_native.alias(
    name = "jar_builder",
    actual = ":jar_builder_prebuilt",
    visibility = ["PUBLIC"],
)

# This is a prebuilt jar so that it can be part of the bsmr bootstrap toolchain.
bsmr_prebuilt_jar(
    name = "jar_builder_prebuilt",
    _dex_toolchain = "toolchains//:empty_dex",
    binary_jar = ":jar_builder_main.jar",
    should_generate_snapshot = False,
    visibility = ["PUBLIC"],
)

# To rebuild the jar and upload it to CAS, do:
# bsmr build prelude//toolchains/android/src/com/dedalus/bsmr/util/zip:jar_builder_main --show-simple-output | xargs frecli --use-case android_build_infra_tools cas upload-blob
bsmr_prebuilt_artifact(
    name = "jar_builder_main.jar",
    # @oss-disable[end= ]: cas_digest = "73149775903042a6a323255a7b40862323c8afc35afd582c4b8861ff77d8fbe9:23604183",
    oss_sha1 = "18f839ebb58babae4ae35900ef33cdf065d0cbc5",
    oss_url = "https://github.com/facebook/buck2/releases/download/androidToolchain%2F2025-04-03/jar_builder_main.jar",
)

bsmr_java_binary(
    name = "jar_builder_main",
    main_class = "com.dedalus.bsmr.util.zip.JarBuilderMain",
    deps = [
        ":jar_builder_main_lib",
    ],
)

bsmr_java_binary(
    name = "jar_diff",
    main_class = "com.dedalus.bsmr.util.zip.JarDiff",
    visibility = ["PUBLIC"],
    deps = [
        ":jar_builder_main_lib",
    ],
)
