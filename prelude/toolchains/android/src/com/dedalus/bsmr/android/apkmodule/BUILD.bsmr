load("@prelude//toolchains/android/tools:build_rules.bzl", "bsmr_java_binary", "bsmr_java_library", "bsmr_kotlin_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

APK_MODULE_ONLY = [
    "APKModule.kt",
]

BINARY_SRCS = ["APKModuleGraphExecutableMain.java"]

bsmr_kotlin_library(
    name = "module-only",
    srcs = APK_MODULE_ONLY,
    tests = [
        "prelude//toolchains/android/test/com/dedalus/bsmr/android/apkmodule:apkmodule",
    ],
    visibility = ["PUBLIC"],
    deps = [],
    exported_deps = [],
)

bsmr_java_library(
    name = "apkmodule",
    srcs = glob(
        ["*.java"],
        exclude = APK_MODULE_ONLY + BINARY_SRCS,
    ),
    tests = [
        "prelude//toolchains/android/test/com/dedalus/bsmr/android/apkmodule:apkmodule",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/util/graph:graph",
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/filesystem:filesystem",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/classes:classes",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util:util",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:kotlin-annotations",
    ],
    exported_deps = [
        ":module-only",
    ],
)

bsmr_java_library(
    name = "apkmodule-binary-lib",
    srcs = BINARY_SRCS,
    tests = [
        "prelude//toolchains/android/test/com/dedalus/bsmr/android/apkmodule:apkmodule",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/filesystems:filesystems",
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/file:file",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/json:json",
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:kotlin-annotations",
        ":apkmodule",
    ],
)

bsmr_java_binary(
    name = "apkmodule_binary",
    main_class = "com.dedalus.bsmr.android.apkmodule.APKModuleGraphExecutableMain",
    visibility = [
        "PUBLIC",
    ],
    deps = [
        ":apkmodule-binary-lib",
    ],
)
