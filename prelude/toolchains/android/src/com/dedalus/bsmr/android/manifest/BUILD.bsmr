load("@prelude//toolchains/android/tools:build_rules.bzl", "SIGNED_JAR_BLOCKLIST", "bsmr_java_binary", "bsmr_java_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_java_library(
    name = "manifest",
    srcs = glob(["*.java"]),
    visibility = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/android/...",
        "prelude//toolchains/android/test/com/dedalus/bsmr/...",
    ],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/android:manifest_utils",
        "prelude//toolchains/android/src/com/dedalus/bsmr/android/apkmodule:module-only",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util:throwing_print_writer",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/environment:platform",
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:kotlin-annotations",
        "prelude//toolchains/android/third-party:manifest-merger",
        "prelude//toolchains/android/third-party:tools-sdk-common",
    ],
)

bsmr_java_binary(
    name = "generate_manifest_binary",
    blocklist = SIGNED_JAR_BLOCKLIST,
    main_class = "com.dedalus.bsmr.android.manifest.GenerateManifestExecutableMain",
    visibility = ["PUBLIC"],
    deps = [
        ":manifest",
    ],
)

bsmr_java_binary(
    name = "replace_application_id_placeholders_binary",
    blocklist = SIGNED_JAR_BLOCKLIST,
    main_class = "com.dedalus.bsmr.android.manifest.ReplaceApplicationIdPlaceholdersExecutableMain",
    visibility = ["PUBLIC"],
    deps = [
        ":manifest",
    ],
)
