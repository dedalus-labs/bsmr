load("@prelude//toolchains/android/tools:build_rules.bzl", "bsmr_java_binary", "bsmr_java_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_java_library(
    name = "build_config",
    srcs = [
        "BuildConfigFields.java",
        "BuildConfigs.java",
    ],
    visibility = [
        "PUBLIC",
    ],
    deps = [
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:kotlin-annotations",
    ],
    exported_deps = [],
)

bsmr_java_library(
    name = "executable",
    srcs = ["GenerateBuildConfigExecutableMain.java"],
    visibility = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/android/build_config:generate_build_config_binary",
    ],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/util:throwing_print_writer",
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:kotlin-annotations",
        ":build_config",
    ],
)

bsmr_java_binary(
    name = "generate_build_config_binary",
    main_class = "com.dedalus.bsmr.android.build_config.GenerateBuildConfigExecutableMain",
    visibility = [
        "PUBLIC",
    ],
    deps = [
        ":build_config",
        ":executable",
    ],
)
