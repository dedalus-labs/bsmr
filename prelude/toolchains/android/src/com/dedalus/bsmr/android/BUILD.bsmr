load(
    "@prelude//toolchains/android/tools:build_rules.bzl",
    "bsmr_java_binary",
    "bsmr_java_library",
    "bsmr_kotlin_library",
)
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

HELPERS_SRCS = [
    "AdbHelper.java",
    "AdbOptions.java",
    "AdbExecutionContext.java",
    "AndroidInstallPrinter.java",
    "exopackage/ExoHelper.java",
    "exopackage/DexExoHelper.java",
    "exopackage/ExopackageInstaller.java",
    "exopackage/ExopackageMode.java",
    "exopackage/ExopackageUtil.java",
    "exopackage/NativeExoHelper.java",
    "exopackage/AdbUtils.kt",
    "exopackage/AndroidDeviceImpl.kt",
    "exopackage/ResourcesExoHelper.java",
]

bsmr_kotlin_library(
    name = "helpers",
    srcs = HELPERS_SRCS,
    tests = [
        "prelude//toolchains/android/test/com/dedalus/bsmr/android:unit",
    ],
    visibility = [
        "PUBLIC",
    ],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/android/apex:apex_manifest",
        "prelude//toolchains/android/src/com/dedalus/bsmr/android/device:device",
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/util/log:log",
        "prelude//toolchains/android/src/com/dedalus/bsmr/installer/android:exceptions",
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/filesystem/impl:utils",
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/pathformat:pathformat",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util:process_executor",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util:util",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/environment:environment",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:kotlin-annotations",
        "prelude//toolchains/android/third-party:kotlinx-coroutines-core-jvm",
        "prelude//toolchains/android/third-party:zstd-jni",
        ":manifest_utils",
        ":utils_api",
    ],
    exported_deps = [],
)

MANIFEST_UTILS_SRCS = [
    "AndroidManifestReader.java",
    "AndroidManifestReaderExecutableMain.java",
    "DefaultAndroidManifestReader.java",
]

bsmr_java_binary(
    name = "manifest_utils_binary",
    main_class = "com.dedalus.bsmr.android.AndroidManifestReaderExecutableMain",
    visibility = [
        "PUBLIC",
    ],
    deps = [
        ":manifest_utils",
    ],
)

bsmr_java_library(
    name = "manifest_utils",
    srcs = MANIFEST_UTILS_SRCS,
    tests = [
        "prelude//toolchains/android/test/com/dedalus/bsmr/android:unit",
    ],
    visibility = [
        "PUBLIC",
    ],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/xml:xml",
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:kotlin-annotations",
    ],
)

UTILS_API_SRCS = [
    "exopackage/AndroidDevicesHelper.java",
    "exopackage/IsolatedExopackageInfo.kt",
    "exopackage/AndroidDeviceInfo.kt",
    "exopackage/AndroidDevice.java",
    "exopackage/AndroidIntent.java",
    "IsolatedApkInfo.java",
    "exopackage/PackageInfo.java",
]

bsmr_kotlin_library(
    name = "utils_api",
    srcs = UTILS_API_SRCS,
    visibility = [
        "PUBLIC",
    ],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/filesystem:filesystem",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util:util",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/environment:platform",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/xml:xml",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:kotlin-annotations",
    ],
)
