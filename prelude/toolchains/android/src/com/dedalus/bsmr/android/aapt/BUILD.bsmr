load("@prelude//toolchains/android/tools:build_rules.bzl", "SIGNED_JAR_BLOCKLIST", "bsmr_java_binary", "bsmr_java_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

MERGE_ANDROID_RESOURCE_SOURCES_SRCS = [
    "MergeAndroidResourceSourcesExecutableMain.java",
    "MergeAndroidResourceSourcesUtils.java",
]

MINI_AAPT_SOURCES = [
    "MiniAapt.java",
    "MiniAaptExecutableMain.java",
]

R_DOT_TXT_SOURCES = [
    "RDotTxtEntry.java",
    "FakeRDotTxtEntry.java",
]

bsmr_java_library(
    name = "r_dot_txt",
    srcs = R_DOT_TXT_SOURCES,
    tests = [
        "prelude//toolchains/android/test/com/dedalus/bsmr/android/aapt:aapt",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:jsr305",
        "prelude//toolchains/android/third-party:kotlin-annotations",
    ],
)

bsmr_java_library(
    name = "mini_aapt",
    srcs = MINI_AAPT_SOURCES,
    visibility = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/android/...",
        "prelude//toolchains/android/test/com/dedalus/bsmr/...",
    ],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/filesystem/impl:utils",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util:throwing_print_writer",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/xml:xml",
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:jsr305",
        "prelude//toolchains/android/third-party:kotlin-annotations",
        ":r_dot_txt",
    ],
)

bsmr_java_binary(
    name = "mini_aapt_binary",
    main_class = "com.dedalus.bsmr.android.aapt.MiniAaptExecutableMain",
    visibility = [
        "PUBLIC",
    ],
    deps = [
        ":mini_aapt",
    ],
)

bsmr_java_library(
    name = "merge_android_resource_sources",
    srcs = MERGE_ANDROID_RESOURCE_SOURCES_SRCS,
    deps = [
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:layoutlib-api",
        "prelude//toolchains/android/third-party:tools-sdk-common",
    ],
)

bsmr_java_binary(
    name = "merge_android_resource_sources_binary",
    blocklist = SIGNED_JAR_BLOCKLIST,
    main_class = "com.dedalus.bsmr.android.aapt.MergeAndroidResourceSourcesExecutableMain",
    visibility = [
        "PUBLIC",
    ],
    deps = [
        "prelude//toolchains/android/third-party:kotlin-stdlib",
        ":merge_android_resource_sources",
    ],
)
