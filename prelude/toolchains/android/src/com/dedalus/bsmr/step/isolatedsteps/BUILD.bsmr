load("@prelude//toolchains/android/tools:build_rules.bzl", "bsmr_java_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_java_library(
    name = "isolatedsteps",
    srcs = glob(["*.java"]),
    visibility = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/...",
        "prelude//toolchains/android/test/com/dedalus/bsmr/...",
    ],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/json:json",
        "prelude//toolchains/android/third-party:guava",
    ],
    exported_deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/build/execution/context:context",
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/util/log:log",
        "prelude//toolchains/android/src/com/dedalus/bsmr/step:step",
    ],
)
