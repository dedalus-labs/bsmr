load("@prelude//toolchains/android/tools:build_rules.bzl", "bsmr_java_binary", "bsmr_java_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_java_library(
    name = "utils",
    srcs = glob(["*.java"]),
    visibility = ["PUBLIC"],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/core/filesystems:filesystems",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/relativepathmap:relativepathmap",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/zip/collect:collect",
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:guava",
    ],
)

bsmr_java_binary(
    name = "zip_binary",
    main_class = "com.dedalus.bsmr.features.zip.rules.utils.ZipMain",
    visibility = ["PUBLIC"],
    deps = [
        ":utils",
    ],
)
