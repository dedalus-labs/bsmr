load("@prelude//toolchains/android/tools:build_rules.bzl", "bsmr_java_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_java_library(
    name = "graph",
    srcs = glob(["*.java"]),
    tests = [
        "prelude//toolchains/android/test/com/dedalus/bsmr/core/util/graph:graph",
    ],
    visibility = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/android/apkmodule:apkmodule",
        "prelude//toolchains/android/test/com/dedalus/bsmr/android/apkmodule:apkmodule",
        "prelude//toolchains/android/test/com/dedalus/bsmr/core/util/graph:graph",
    ],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/util:util",
        "prelude//toolchains/android/third-party:guava",
    ],
)
