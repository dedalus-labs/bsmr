load("@prelude//toolchains/android/tools:build_rules.bzl", "bsmr_java_binary", "bsmr_java_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_java_binary(
    name = "bootstrapper",
    main_class = "com.dedalus.bsmr.cli.bootstrapper.ClassLoaderBootstrapper",
    visibility = [
        "root//platform/...",
        "none//xplat/bsmr/platform/...",
        "prelude//toolchains/android/config:",
        "prelude//toolchains/android/meta_only/src/com/dedalus/bsmr/jvm/remote_worker/...",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/stepsbuilder/javacd/worker:",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/kotlin/cd/worker:",
        "toolchains//...",
        # @oss-disable[end= ]: "wa_android//bsmr/toolchains/...",
    ],
    deps = [
        ":bootstrapper_lib",
    ],
)

bsmr_java_library(
    name = "bootstrapper_lib",
    srcs = glob(["*.java"]),
    visibility = [
        "PUBLIC",
        "prelude//toolchains/android/test/...",
        "prelude//toolchains/android/third-party/aosp:aosp",
        "prelude//toolchains/android/tools/...",
    ],
    deps = [
        # Be very careful what is added here, and leave comments justifying
        # each addition. The bootstrapper is intended to keep the
        # system ClassLoader free of classes that might conflict with
        # those used by compiler plugins and annotation processors. As such,
        # it cannot depend on third-party libraries, directly or indirectly.
        # This is an internal API used to communicate between Bsmr and the source-based ABI validator
        # running inside javac.
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/abi/source/api:api",
        # This is a set of utility classes for working with javax.lang.model that are useful both
        # from Bsmr and the compiler
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/lang/model:model",
        # This is an internal API used to communicate between Bsmr and the compiler plugin
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/plugin/api:api",
    ],
)
