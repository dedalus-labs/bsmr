load("@prelude//toolchains/android/tools:build_rules.bzl", "bsmr_java_library", "third_party_jar")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_java_library(
    name = "aosp",
    visibility = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/android/manifest:manifest",
        "prelude//toolchains/android/src/com/dedalus/bsmr/cli/bootstrapper:bootstrapper_lib",
    ],
    exported_deps = [
        "prelude//toolchains/android/third-party:android-annotations",
        "prelude//toolchains/android/third-party:android-common",
        "prelude//toolchains/android/third-party:gson",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:kotlin-stdlib",
        "prelude//toolchains/android/third-party:manifest-merger",
        "prelude//toolchains/android/third-party:sdk-common",
        "prelude//toolchains/android/third-party:sdklib",
    ],
)

third_party_jar(
    name = "apksig",
    # @oss-disable[end= ]: internal_alias = "upstream//third-party/java/com/android/tools/build/apksig:apksig",
    sha1 = "d51ecbc4a5b7a2c7832586a4dde18f61d92810a4",
    url = "mvn:https://maven.google.com:com.android.tools.build:apksig:jar:8.4.0",
    visibility = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/android/apk:apk",
        "prelude//toolchains/android/src/com/dedalus/bsmr/android/bundle:bundle",
    ],
)
