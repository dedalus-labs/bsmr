load("@prelude//toolchains/android/tools:build_rules.bzl", "bsmr_java_library", "bsmr_java_test")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

bsmr_java_library(
    name = "testutil",
    srcs = glob(
        ["*.java"],
        exclude = ["*Test.java"],
    ),
    visibility = [
        "prelude//toolchains/android/test/...",
    ],
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/file:file",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/core:core",
        "prelude//toolchains/android/src/com/dedalus/bsmr/step:step",
        "prelude//toolchains/android/src/com/dedalus/bsmr/test/result/type:type",
        "prelude//toolchains/android/src/com/dedalus/bsmr/test/selectors:selectors",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util:process_executor",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util:util",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/environment:environment",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/environment:platform",
        "prelude//toolchains/android/test/com/dedalus/bsmr/testutil:testutil",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:jackson-annotations",
        "prelude//toolchains/android/third-party:jackson-core",
        "prelude//toolchains/android/third-party:jackson-databind",
        "prelude//toolchains/android/third-party:jsr305",
        "prelude//toolchains/android/third-party:junit",
    ],
    exported_deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/function:function",
    ],
)

bsmr_java_test(
    name = "util",
    srcs = glob(["*Test.java"]),
    deps = [
        "prelude//toolchains/android/src/com/dedalus/bsmr/android:helpers",
        "prelude//toolchains/android/src/com/dedalus/bsmr/io/file:file",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/core:core",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java:steps",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java:support",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/abi/source/api:api",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/classes:classes",
        "prelude//toolchains/android/src/com/dedalus/bsmr/jvm/java/fatjar:fat_jar_utils",
        "prelude//toolchains/android/src/com/dedalus/bsmr/step:step",
        "prelude//toolchains/android/src/com/dedalus/bsmr/test/result/type:type",
        "prelude//toolchains/android/src/com/dedalus/bsmr/test/selectors:selectors",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util:process_executor",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util:util",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/environment:environment",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/environment:platform",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/function:function",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/json:json",
        "prelude//toolchains/android/src/com/dedalus/bsmr/util/unit:unit",
        "prelude//toolchains/android/test/com/dedalus/bsmr/testutil:testutil",
        "prelude//toolchains/android/test/com/dedalus/bsmr/testutil/integration:util",
        "prelude//toolchains/android/test/com/dedalus/bsmr/util:testutil",
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:asm",
        "prelude//toolchains/android/third-party:dd-plist",
        "prelude//toolchains/android/third-party:ddmlib",
        "prelude//toolchains/android/third-party:guava",
