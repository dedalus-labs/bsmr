# Exposes the complete OCI helper module closure as tracked source artifacts.

load("@prelude//utils:source_listing.bzl", "source_listing")

source_listing()

# Keep imported modules adjacent; separately copied export targets do not retain
# their relative module paths. The constructors track every referenced source.
export_file(name = "operations", src = "operations.mjs", mode = "reference", visibility = ["PUBLIC"])
export_file(name = "closure", src = "closure.mjs", mode = "reference", visibility = ["PUBLIC"])
