# Exposes the native Python action runner and inventories this package's sources.

load("@prelude//utils:source_listing.bzl", "source_listing")

source_listing()

export_file(
    name = "runner",
    src = "runner.py",
    visibility = ["PUBLIC"],
)

export_file(
    name = "runtime",
    src = "runtime.py",
    visibility = ["PUBLIC"],
)
