[project]
root = .

[cells]
root = .
prelude = prelude
none = none

[cell_aliases]
config = prelude
ovr_config = prelude
toolchains = root

[external_cells]
prelude = bundled

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default

[build]
execution_platforms = prelude//platforms:default
