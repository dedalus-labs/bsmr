{
	"name": "bsmr-ci",
	"private": true,
	"type": "module",
	"scripts": {
		"ci:check": "pnpm run ci:typecheck && pnpm run ci:test && pnpm run ci:check:generated && pnpm run ci:check:security",
		"ci:check:generated": "hollywood check --generated --source-root ci --output .",
		"ci:check:security": "hollywood check --workflow-security --source-root .github/workflows --output .",
		"ci:generate": "hollywood generate \"ci/**/*.ts\" --output .",
		"ci:test": "node --experimental-strip-types --test ci/ci.test.ts",
		"ci:typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@dedalus-labs/hollywood": "0.0.1",
		"@types/node": "26.0.1",
		"typescript": "6.0.3"
	},
	"engines": {
		"node": "26.5.1"
	},
	"packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
