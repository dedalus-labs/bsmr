# Defines build targets for packages/rust/static_interner.

load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "static_interner",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    # bsmr uses every integration impl (`Allocative`, `Dupe`, `StrongHash`) on
    # `Intern<T>`, so enable all features. OSS users on crates.io opt in via
    # cargo features as needed; default is no impls.
    features = [
        "allocative",
        "dupe",
        "strong_hash",
    ],
    deps = [
        "bsmr_build//third-party/rust:equivalent",
        "root//packages/rust/allocative/allocative:allocative",
        "root//packages/rust/gazebo/dupe:dupe",
        "root//packages/rust/gazebo/strong_hash:strong_hash",
        "root//packages/rust/lock_free_hashtable:lock_free_hashtable",
    ],
)
