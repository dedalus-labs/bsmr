# Defines build targets for packages/rust/setsketch.

load("@bsmr_build//rules:rust.bzl", "rust_binary")
load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "setsketch",
    srcs = glob(["src/**/*.rs"]),
    test_deps = [
        "bsmr_build//third-party/rust:fnv",
    ],
    deps = [
        "bsmr_build//third-party/rust:base64",
        "bsmr_build//third-party/rust:rand",
        "bsmr_build//third-party/rust:rand_distr",
        "bsmr_build//third-party/rust:rand_xoshiro",
    ],
)

rust_binary(
    name = "sketch_size",
    srcs = ["bin/sketch_size.rs"],
    crate_root = "bin/sketch_size.rs",
    deps = [
        "bsmr_build//third-party/rust:anyhow",
        ":setsketch",
    ],
)
