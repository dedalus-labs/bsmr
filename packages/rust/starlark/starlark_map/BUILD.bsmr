load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "starlark_map",
    srcs = glob(["src/**/*.rs"]),
    # Controls whether to depend on the pagable crate.
    # This is independent from the "pagable" constraint on the starlark crate,
    # which controls pagable serialization/deserialization support for starlark values.
    features = ["pagable_dep"],
    modifiers = [
        # @oss-disable[end= ]: "ovr_config//rust:panic_unwind",
    ],
    rustc_flags = [
        "--cfg=rust_nightly",
    ],
    test_deps = [
        "bsmr_build//third-party/rust:serde_json",
    ],
    deps = [
        "bsmr_build//third-party/rust:equivalent",
        "bsmr_build//third-party/rust:fxhash",
        "bsmr_build//third-party/rust:hashbrown",
        "bsmr_build//third-party/rust:serde",
        "root//packages/rust/allocative/allocative:allocative",
        "root//packages/rust/gazebo/dupe:dupe",
        "root//packages/rust/gazebo/strong_hash:strong_hash",
        "root//packages/rust/pagable/pagable:pagable",
    ],
)
