# Defines build targets for packages/rust/starlark/benchmark_memory.

load("@bsmr_build//rules:rust.bzl", buck_rust_binary = "rust_binary")

oncall("build_infra")

buck_rust_binary(
    name = "benchmark_memory",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    crate_root = "src/main.rs",
    deps = [
        "bsmr_build//third-party/rust:clap",
        "root//packages/rust/starlark/starlark:starlark",
        "root//packages/rust/starlark/starlark_syntax:starlark_syntax",
    ] + select({
        "DEFAULT": [],
        "ovr_config//os:linux": [
            "bsmr_build//third-party/rust:libc",
        ],
    }),
)
