# Defines build targets for packages/rust/starlark/starlark.

load("@bsmr_build//rules:native_rules.bzl", "alias", "buck_filegroup")
load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

# Constraint controlling the "pagable" Cargo feature of the starlark crate.
# When enabled, pagable serialization/deserialization support for starlark values is enabled.
# Bessemer internal targets set this to "enabled" via package modifier in bsmr/PACKAGE.
# External consumers get "disabled" by default.
constraint(
    name = "pagable",
    default = "disabled",
    execution_modifier = True,
    values = [
        "enabled",
        "disabled",
    ],
    visibility = ["PUBLIC"],
)

alias(
    name = "starlark-bin",
    actual = "root//packages/rust/starlark/starlark_bin:starlark_bin",
)

buck_filegroup(
    name = "testcases",
    srcs = glob([
        "src/**/golden/**",
        "src/**/*.golden",
        "testcases/**",
    ]),
    copy = False,
)

rust_library(
    name = "starlark",
    srcs = glob(["src/**/*.rs"]),
    # `pagable` controls type registration for starlark values which shouldn't be enforced everywhere.
    # `pagable_dep` controls whether to depend on pagable at all, used for OSS because to support stable rustc.
    features = select({
        ":pagable[enabled]": [
            "pagable",
            "pagable_dep",
        ],
        "DEFAULT": ["pagable_dep"],
    }),
    rustc_flags = [
        "--cfg=rust_nightly",
    ] + select({
        ":pagable[enabled]": ["--cfg=starlark_require_heap_names"],
        "DEFAULT": [],
    }),
    test_deps = [
        "bsmr_build//third-party/rust:rand",
        # This is a hack to build `:testcases` when invoking a test.
        # Otherwise `OUT_DIR` is set, but it points to non-existing directory.
        # This is likely a bug in `rust_test` rule.
        ":testcases",
    ],
    test_env = {
        # Some of our tests include testcase files relative to CARGO_MANIFEST_DIR.
        # This is a hack that allows both `cargo test` and `buck test` to work.
        "CARGO_MANIFEST_DIR": "$(location :testcases)",
    },
    deps = [
        "bsmr_build//third-party/rust:anyhow",
        "bsmr_build//third-party/rust:blake3",
        "bsmr_build//third-party/rust:bumpalo",
        "bsmr_build//third-party/rust:dashmap",
        "bsmr_build//third-party/rust:debugserver-types",
        "bsmr_build//third-party/rust:derivative",
        "bsmr_build//third-party/rust:derive_more",
        "bsmr_build//third-party/rust:either",
        "bsmr_build//third-party/rust:erased-serde",
        "bsmr_build//third-party/rust:hashbrown",
        "bsmr_build//third-party/rust:indexmap",
        "bsmr_build//third-party/rust:inventory",
        "bsmr_build//third-party/rust:itertools",
        "bsmr_build//third-party/rust:maplit",
        "bsmr_build//third-party/rust:num-bigint",
        "bsmr_build//third-party/rust:num-traits",
        "bsmr_build//third-party/rust:once_cell",
        "bsmr_build//third-party/rust:paste",
        "bsmr_build//third-party/rust:ref-cast",
        "bsmr_build//third-party/rust:regex",
        "bsmr_build//third-party/rust:rustyline",
        "bsmr_build//third-party/rust:serde",
        "bsmr_build//third-party/rust:serde_json",
        "bsmr_build//third-party/rust:static_assertions",
        "bsmr_build//third-party/rust:strsim",
        "bsmr_build//third-party/rust:textwrap",
        "bsmr_build//third-party/rust:thiserror",
        "root//packages/rust/allocative/allocative:allocative",
        "root//packages/rust/gazebo/cmp_any:cmp_any",
        "root//packages/rust/gazebo/display_container:display_container",
        "root//packages/rust/gazebo/dupe:dupe",
        "root//packages/rust/gazebo/strong_hash:strong_hash",
        "root//packages/rust/pagable/pagable:pagable",
        "root//packages/rust/starlark/starlark_derive:starlark_derive",
        "root//packages/rust/starlark/starlark_map:starlark_map",
        "root//packages/rust/starlark/starlark_syntax:starlark_syntax",
    ],
)
