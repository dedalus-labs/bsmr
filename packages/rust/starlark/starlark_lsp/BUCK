    ],
    deps = [
        "bsmr_build//third-party/rust:derivative",
        "bsmr_build//third-party/rust:derive_more",
        "bsmr_build//third-party/rust:itertools",
        "bsmr_build//third-party/rust:lsp-server",
        "bsmr_build//third-party/rust:lsp-types",
        "bsmr_build//third-party/rust:serde",
        "bsmr_build//third-party/rust:serde_json",
        "bsmr_build//third-party/rust:thiserror",
        "bsmr_build//third-party/rust:tower-lsp-server",
        "root//packages/rust/gazebo/dupe:dupe",
        "root//packages/rust/starlark/starlark:starlark",
        "root//packages/rust/starlark/starlark_syntax:starlark_syntax",
    ],
