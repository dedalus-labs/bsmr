load("@bsmr_build//rules:rust.bzl", "rust_binary")
load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("rust_foundation")

rust_library(
    name = "buck_resources",
    srcs = [
        "src/lib.rs",
        "src/manifest.rs",
    ],
    # Prefer to use the published version of this library through crates.io,
    # instead of this target. bsmr_build//third-party/rust:buck-resources
    visibility = [],
    deps = [
        "bsmr_build//third-party/rust:dunce",
        "bsmr_build//third-party/rust:once_cell",
        "bsmr_build//third-party/rust:serde",
        "bsmr_build//third-party/rust:serde_json",
        "bsmr_build//third-party/rust:thiserror",
    ],
)

rust_binary(
    name = "hello",
    srcs = ["tests/src/hello.rs"],
    unittests = False,
)

rust_binary(
    name = "buck_resources_test",
    srcs = ["tests/src/main.rs"],
    resources = {
        "hello_binary": ":hello",
    },
    deps = [
        ":buck_resources",
    ],
)
