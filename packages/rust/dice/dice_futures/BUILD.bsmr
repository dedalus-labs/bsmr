# Defines build targets for packages/rust/dice/dice_futures.

load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "dice_futures",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    test_deps = [
        "bsmr_build//third-party/rust:assert_matches",
    ],
    deps = [
        "bsmr_build//third-party/rust:futures",
        "bsmr_build//third-party/rust:parking_lot",
        "bsmr_build//third-party/rust:pin-project",
        "bsmr_build//third-party/rust:slab",
        "bsmr_build//third-party/rust:thiserror",
        "bsmr_build//third-party/rust:tokio",
        "root//packages/rust/gazebo/dupe:dupe",
    ],
)
