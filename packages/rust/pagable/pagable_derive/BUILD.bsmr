# Defines build targets for packages/rust/pagable/pagable_derive.

load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "pagable_derive",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    crate_root = "src/lib.rs",
    proc_macro = True,
    deps = [
        "bsmr_build//third-party/rust:proc-macro2",
        "bsmr_build//third-party/rust:quote",
        "bsmr_build//third-party/rust:syn",
    ],
)
