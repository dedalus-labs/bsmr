    crate_root = "src/lib.rs",
    features = select({
        "DEFAULT": ["tokio"],
        # @oss-disable[end= ]: "ovr_config//runtime/constraints:wasm": [],
    }),
    deps = [
        "bsmr_build//third-party/rust:anyhow",
        "bsmr_build//third-party/rust:async-trait",
        "bsmr_build//third-party/rust:blake3",
        "bsmr_build//third-party/rust:bytemuck",
        "bsmr_build//third-party/rust:dashmap",
        "bsmr_build//third-party/rust:either",
        "bsmr_build//third-party/rust:erased-serde",
        "bsmr_build//third-party/rust:fancy-regex",
        "bsmr_build//third-party/rust:indexmap",
        "bsmr_build//third-party/rust:inventory",
        "bsmr_build//third-party/rust:num-bigint",
        "bsmr_build//third-party/rust:once_cell",
        "bsmr_build//third-party/rust:parking_lot",
        "bsmr_build//third-party/rust:postcard",
        "bsmr_build//third-party/rust:regex",
        "bsmr_build//third-party/rust:sequence_trie",
        "bsmr_build//third-party/rust:serde",
        "bsmr_build//third-party/rust:serde_json",
        "bsmr_build//third-party/rust:smallvec",
        "bsmr_build//third-party/rust:sorted_vector_map",
        "bsmr_build//third-party/rust:static_assertions",
        "bsmr_build//third-party/rust:take_mut",
        "bsmr_build//third-party/rust:thiserror",
        "bsmr_build//third-party/rust:tokio",
        "bsmr_build//third-party/rust:triomphe",
        "root//packages/rust/allocative/allocative:allocative",
