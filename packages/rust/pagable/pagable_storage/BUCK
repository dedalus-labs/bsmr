    name = "pagable_storage",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    # FIXME(JakobDegen): Needed because autocargo doesn't handle the select below
    autocargo = {
        "edge_features": [
            "tokio",
        ],
    },
    crate_root = "src/lib.rs",
    features = select({
        "DEFAULT": ["tokio"],
        # @oss-disable[end= ]: "ovr_config//runtime/constraints:wasm": [],
    }),
    deps = [
        "bsmr_build//third-party/rust:anyhow",
        "bsmr_build//third-party/rust:async-trait",
        "bsmr_build//third-party/rust:bytemuck",
        "bsmr_build//third-party/rust:rusqlite",
        "bsmr_build//third-party/rust:sled",
        "bsmr_build//third-party/rust:tokio",
        "root//packages/rust/pagable/pagable:pagable",
    ],
)
