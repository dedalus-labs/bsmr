# Defines build targets for packages/rust/host_sharing.

load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "host_sharing",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    deps = [
        "bsmr_build//third-party/rust:anyhow",
        "bsmr_build//third-party/rust:dashmap",
        "bsmr_build//third-party/rust:futures-intrusive",
        "root//packages/rust/allocative/allocative:allocative",
        "root//packages/rust/pagable/pagable:pagable",
        "root//packages/rust/starlark/starlark_map:starlark_map",
    ],
)
