# Defines build targets for packages/rust/superconsole.

load("@bsmr_build//rules:rust.bzl", "rust_binary")
load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "superconsole",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    crate_root = "src/lib.rs",
    test_deps = [
        "bsmr_build//third-party/rust:anyhow",
        "bsmr_build//third-party/rust:derive_more",
    ],
    deps = [
        "bsmr_build//third-party/rust:bytes",
        "bsmr_build//third-party/rust:crossbeam-channel",
        "bsmr_build//third-party/rust:crossterm",
        "bsmr_build//third-party/rust:futures",
        "bsmr_build//third-party/rust:itertools",
        "bsmr_build//third-party/rust:pin-project",
        "bsmr_build//third-party/rust:take_mut",
        "bsmr_build//third-party/rust:termwiz",
        "bsmr_build//third-party/rust:thiserror",
        "bsmr_build//third-party/rust:tokio",
        "bsmr_build//third-party/rust:tokio-stream",
        "bsmr_build//third-party/rust:tokio-util",
        "bsmr_build//third-party/rust:tracing",
        "bsmr_build//third-party/rust:unicode-segmentation",
    ] + select({
        "DEFAULT": [],
        "ovr_config//os:linux": [
            "bsmr_build//third-party/rust:nix",
        ],
        "ovr_config//os:macos": [
            "bsmr_build//third-party/rust:nix",
        ],
    }),
)

rust_binary(
    name = "cargo",
    srcs = ["examples/cargo.rs"]
    + glob([
        "examples/cargo/**",
    ]),
    crate_root = "examples/cargo.rs",
    deps = [
        ":superconsole",
    ],
)

rust_binary(
    name = "finalization",
    srcs = ["examples/finalization.rs"],
    deps = [
        "bsmr_build//third-party/rust:derive_more",
        "bsmr_build//third-party/rust:tokio",
        ":superconsole",
    ],
)

rust_binary(
    name = "hello_world",
    srcs = ["examples/hello_world.rs"],
    deps = [
        "bsmr_build//third-party/rust:tokio",
        ":superconsole",
    ],
)

rust_binary(
    name = "readme",
    srcs = ["examples/readme.rs"],
    deps = [
        "bsmr_build//third-party/rust:anyhow",
        ":superconsole",
    ],
)

rust_binary(
    name = "stylized",
    srcs = ["examples/stylized.rs"],
    deps = [
        "bsmr_build//third-party/rust:derive_more",
        "bsmr_build//third-party/rust:tokio",
        ":superconsole",
    ],
)
