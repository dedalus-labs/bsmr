load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "dupe",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    deps = [
        "root//packages/rust/gazebo/dupe_derive:dupe_derive",
    ],
)
