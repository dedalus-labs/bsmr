# Defines build targets for packages/rust/gazebo/strong_hash.

load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "strong_hash",
    srcs = glob(["src/**/*.rs"]),
    features = [
        "num-bigint",
        "triomphe",
    ],
    deps = [
        "bsmr_build//third-party/rust:num-bigint",
        "bsmr_build//third-party/rust:ref-cast",
        "bsmr_build//third-party/rust:triomphe",
        "root//packages/rust/gazebo/strong_hash_derive:strong_hash_derive",
    ],
)
