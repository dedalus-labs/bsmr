# Defines build targets for packages/rust/gazebo/strong_hash_tests.

load("@bsmr_build//rules:rust.bzl", "rust_unittest")

oncall("build_infra")

rust_unittest(
    name = "strong_hash_tests",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "bsmr_build//third-party/rust:blake3",
        "root//packages/rust/gazebo/strong_hash:strong_hash",
    ],
)
