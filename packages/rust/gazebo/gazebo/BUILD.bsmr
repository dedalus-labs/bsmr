load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "gazebo",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    features = [
        "str_pattern_extensions",
    ],
    deps = [
        "root//packages/rust/gazebo/dupe:dupe",
        "root//packages/rust/gazebo/gazebo_derive:gazebo_derive",
    ],
)
