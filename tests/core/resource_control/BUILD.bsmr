load("@root//tests:bsmr_e2e.bzl", "bsmr_core_tests")

oncall("build_infra")

bsmr_core_tests(
    target_extra_attrs = {
        "test_action_suspension": {
            "env": {
                "USE_SOME_MEMORY_BIN": "$(location root//tools/testing/cgroups/use_some_memory:use_some_memory)",
            },
            "skip_for_os": [
                "darwin",
                "windows",
            ],
        },
        "test_daemon_cgroup_fallback": {
            "skip_for_os": [
                "darwin",
                "windows",
            ],
        },
        "test_daemon_cgroup_version_gate": {
            "skip_for_os": [
                "darwin",
                "windows",
            ],
        },
        "test_hybrid_execution_resource_control": {
            "env": {
                "USE_SOME_MEMORY_BIN": "$(location root//tools/testing/cgroups/use_some_memory:use_some_memory)",
            },
            "skip_for_os": [
                "darwin",
                "windows",
            ],
        },
        "test_instruction_count": {
            "env": {
                "THREE_BILLION_INSTRUCTIONS_BIN": "$(location root//tools/testing/three-billion-instructions:three_billion_instructions-bin)",
            },
        },
        "test_memory_reporting": {
            "env": {
                "USE_SOME_MEMORY_BIN": "$(location root//tools/testing/cgroups/use_some_memory:use_some_memory)",
            },
            "skip_for_os": [
                "darwin",
                "windows",
            ],
            "use_compiled_bsmr_client_and_tpx": True,
        },
        "test_network_isolation": {
            "skip_for_os": [
                "darwin",
                "windows",
            ],
            "use_compiled_bsmr_client_and_tpx": True,
        },
        "test_orphan_pids_killed": {
            "skip_for_os": [
                "darwin",
                "windows",
            ],
        },
    },
)
