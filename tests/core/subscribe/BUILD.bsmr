load("@root//tests:buck_e2e.bzl", "bsmr_core_tests")

oncall("build_infra")

bsmr_core_tests(
    target_extra_attrs = {
        "test_subscribe": {
            "env": {
                "BSMR_EXPECT": "$(exe_target root//tests/core/subscribe/bsmr_expect:bsmr_expect)",
            },
        },
    },
)
