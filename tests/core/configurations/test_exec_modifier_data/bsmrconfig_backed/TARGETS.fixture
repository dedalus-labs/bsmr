load("@prelude//cfg/modifier:bsmrconfig_backed_modifiers.bzl", "BsmrconfigBackedModifier", "bsmrconfig_backed_modifiers")
load("//:defs.bzl", "labeled_dummy")

# The bsmrconfig-backed modifier rule that injects bsmrconfig_backed:enabled
# as a post_platform_modifier. This modifier should apply to target configurations
# but NOT to exec dep configurations.
bsmrconfig_backed_modifiers(
    name = "bsmrconfig_modifiers",
    pre_platform = [],
    post_platform = [
        BsmrconfigBackedModifier(
            section = "test",
            property = "enable_bsmrconfig_backed",
            value = True,
            modifiers = ["//cfg:bsmrconfig_backed[enabled]"],
            oncall = "build_infra",
        ),
    ],
    pre_cli = [],
)

# A simple tool - this is used as an exec_dep
# When configured as exec_dep, it should NOT get bsmrconfig_backed:enabled from bsmrconfig-backed modifiers
labeled_dummy(
    name = "simple_tool",
)

# A binary that uses the tool as exec_dep
# The binary SHOULD get bsmrconfig_backed:enabled from bsmrconfig-backed modifiers
# The tool (exec_dep) should NOT get bsmrconfig_backed:enabled
labeled_dummy(
    name = "binary_with_bsmrconfig_modifier",
    # set a modifier to ensure that the bsmrconfig-backed modifier is applied
    modifiers = ["root//cfg:compiler[clang]"],
    exec_deps = [":simple_tool"],
    default_target_platform = "root//cfg:debug_platform",
)
