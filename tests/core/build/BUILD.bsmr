load("@root//tests:bsmr_e2e.bzl", "bsmr_core_tests")

oncall("build_infra")

bsmr_core_tests(
    target_extra_attrs = {
        "test_artifact_path_sketch": {
            # TODO(scottcao): Extend these to mac/windows
            "compatible_with": ["ovr_config//os:linux"],
        },
        "test_critical_path": {
            "use_compiled_bsmr_client_and_tpx": True,
        },
        "test_memory_sketches": {
            "env": {
                "SKETCH_SIZE_BIN": "$(location root//packages/rust/setsketch:sketch_size)",
            },
        },
        "test_paranoid": {
            "data": "root//tests/targets:isolated_targets",
        },
        "test_uncategorized": {
            "env": {
                "RECLI": "$(location upstream//xplat/remote_execution/dotslash:recli)",
            },
        },
    },
)
