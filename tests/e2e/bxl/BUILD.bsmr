load("@root//tests:buck_e2e.bzl", "bsmr_e2e_test")

oncall("build_infra")

bsmr_e2e_test(
    name = "test_bxl",
    srcs = ["test_bxl.py"],
    data = "root//tests/targets:isolated_targets",
    env = {
        "OVR_CONFIG": "1",
        "PRELUDE": "$(location prelude//:prelude)",
    },
    skip_for_os = [
        "darwin",
    ],
    deps = [
        "root//tests/e2e_util:utils",  # @autodeps2-fixme-manual
    ],
)

bsmr_e2e_test(
    name = "test_bxl_query",
    srcs = ["test_bxl_query.py"],
