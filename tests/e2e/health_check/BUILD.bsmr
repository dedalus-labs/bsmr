load("@root//tests:buck_e2e.bzl", "bsmr_e2e_test")
load("@bsmr_build//rules:python_binary.bzl", "python_binary")

oncall("build_infra")

python_binary(
    # @autodeps-skip
    name = "health_check_server_bin",
    srcs = [
        "health_check_server.py",
    ],
    main_function = "bsmr.tests.e2e.health_check.health_check_server.main",
    visibility = ["PUBLIC"],
    deps = [
        "root//app/bsmr_health_check_proto:health_check-py",
        "upstream//third-party/grpc/src/python/grpcio/grpc:grpcio",
    ],
)

bsmr_e2e_test(
    name = "test_health_check",
    srcs = ["test_health_check.py"],
    skip_for_os = [
        "windows",
    ],
    deps = [
        "root//tests/e2e_util:utils",
    ],
)
