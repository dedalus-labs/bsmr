load("@bsmr_build//rules:export_files.bzl", "export_file")
load("@bsmr_build//rules:python_library.bzl", "python_library")

oncall("build_infra")

python_library(
    name = "assert_occurrences",
    srcs = ["helper/assert_occurrences.py"],
)

python_library(
    name = "utils",
    srcs = ["helper/utils.py"],
    deps = [
        "upstream//third-party/pypi/psutil:psutil",
        "root//tests/e2e_util/api:api",
    ],
)

python_library(
    name = "golden",
    srcs = ["helper/golden.py"],
)

python_library(
    name = "utilities",
    srcs = [
        "asserts.py",
        "bsmr_workspace.py",
    ],
    visibility = [
        "PUBLIC",
    ],
    deps = [
        "upstream//third-party/pypi/decorator:decorator",
        "upstream//third-party/pypi/pytest:pytest",
        "root//tests/e2e_util/api:api",
    ],
)

export_file(
    name = "conftest.py",
    src = "conftest.py",
    visibility = ["PUBLIC"],
)

export_file(name = "test_bxl_template.py")

export_file(name = "test_bxl_check_dependencies_template.py")

# Type checking target for Python scripts
python_library(
    name = "scripts-typing",
    srcs = [
        "conftest.py",
        "test_bxl_check_dependencies_template.py",
        "test_bxl_template.py",
    ],
    typing = True,
    deps = [
        "upstream//third-party/pypi/pytest:pytest",
        "root//tests/e2e_util:utilities",
        "root//tests/e2e_util/api:api",
    ],
)
