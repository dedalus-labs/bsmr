load("@bsmr_build//rules:python_library.bzl", "python_library")
# @oss-disable[end= ]: load(":visibility.fb.bzl", "visibility")

oncall("build_infra")

visibility = ["PUBLIC"] # @oss-enable

python_library(
    name = "api",
    srcs = glob(["*.py"]),
    # This is not public API for bsmr invocation, but a part of bsmr_e2e testing framwork.
    # We may want to make it public API, and when we do, let's do it explicitly:
    # * clean
    # * with tests
    # * with public announcement
    visibility = visibility,
)
