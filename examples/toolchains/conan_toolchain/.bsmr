[project]
root = .

[cells]
self = .
prelude = prelude
toolchains = toolchains
none = none

[cell_aliases]
config = prelude
buck = none
fbcode = none
fbcode_macros = none
fbsource = none

[external_cells]
  prelude = bundled

[parser]
target_platform_detector_spec = target://...->prelude//platforms:default
