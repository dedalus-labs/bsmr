# Defines build targets for app/bsmr_common.

load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "bsmr_common",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    autocargo = {
        "cargo_toml_config": {
            "dependencies_override": {
                "dependencies": {
                    "fbinit": {
                        "path": None,
                        "version": "0.2",
                    },
                },
            },
            "extra_buck_dependencies": {
                "dependencies": [
                    (None, "//common/rust/shed/hostcaps:hostcaps"),
                ],
            },
        },
    },
    test_deps = [
        "bsmr_build//third-party/rust:assert_matches",
        "bsmr_build//third-party/rust:indoc",
        "bsmr_build//third-party/rust:tempfile",
        "bsmr_build//third-party/rust:test-case",
        "bsmr_build//third-party/rust:triomphe",
    ],
    deps = [
        "bsmr_build//third-party/rust:async-scoped",
        "bsmr_build//third-party/rust:async-trait",
        "bsmr_build//third-party/rust:blake3",
        "bsmr_build//third-party/rust:bytes",
        "bsmr_build//third-party/rust:chrono",
        "bsmr_build//third-party/rust:compact_str",
        "bsmr_build//third-party/rust:derivative",
        "bsmr_build//third-party/rust:derive_more",
        "bsmr_build//third-party/rust:digest",
        "bsmr_build//third-party/rust:dirs",
        "bsmr_build//third-party/rust:fs4",
        "bsmr_build//third-party/rust:futures",
        "bsmr_build//third-party/rust:globset",
        "bsmr_build//third-party/rust:hex",
        "bsmr_build//third-party/rust:hyper",
        "bsmr_build//third-party/rust:itertools",
        "bsmr_build//third-party/rust:num_enum",
        "bsmr_build//third-party/rust:parking_lot",
        "bsmr_build//third-party/rust:prost-types",
        "bsmr_build//third-party/rust:rand",
        "bsmr_build//third-party/rust:ref-cast",
        "bsmr_build//third-party/rust:regex",
        "bsmr_build//third-party/rust:rusqlite",
        "bsmr_build//third-party/rust:serde",
        "bsmr_build//third-party/rust:serde_json",
        "bsmr_build//third-party/rust:sha1",
        "bsmr_build//third-party/rust:sha2",
        "bsmr_build//third-party/rust:smallvec",
        "bsmr_build//third-party/rust:strsim",
        "bsmr_build//third-party/rust:tokio",
        "bsmr_build//third-party/rust:toml",
        "bsmr_build//third-party/rust:tonic",
        "bsmr_build//third-party/rust:tracing",
        "bsmr_build//third-party/rust:yaml-rust2",
        # @oss-disable[end= ]: "//blake3:blake3-constants-rust-nothrift",
        "root//packages/rust/allocative/allocative:allocative",
        "root//app/bsmr_cli_proto:bsmr_cli_proto",
        "root//app/bsmr_core:bsmr_core",
        "root//app/bsmr_data:bsmr_data",
        "root//app/bsmr_error:bsmr_error",
        "root//app/bsmr_events:bsmr_events",
        "root//app/bsmr_fs:bsmr_fs",
        "root//app/bsmr_hash:bsmr_hash",
        "root//app/bsmr_http:bsmr_http",
        "root//app/bsmr_util:bsmr_util",
        "root//app/bsmr_wrapper_common:bsmr_wrapper_common",
        "root//packages/rust/dice/dice:dice",
        "root//packages/rust/dice/dice_futures:dice_futures",
        # @oss-disable[end= ]: "root//facebook/allocator-stats:allocator-stats",
        "root//packages/rust/gazebo/cmp_any:cmp_any",
        "root//packages/rust/gazebo/dupe:dupe",
        "root//packages/rust/gazebo/gazebo:gazebo",
        "root//packages/rust/pagable/pagable:pagable",
        "root//packages/rust/static_interner:static_interner",
        "root//packages/rust/starlark/starlark_map:starlark_map",
        # @oss-disable[end= ]: "//common/rust/folly/logging:logging",
        # @oss-disable[end= ]: "//common/rust/folly/memory:memory",
        # @oss-disable[end= ]: "//common/rust/gflags:gflags",
        "bsmr_build//third-party/rust:fbinit",
        # @oss-disable[end= ]: "//common/rust/shed/hostcaps:hostcaps",
    ] + select({
        "DEFAULT": [],
        "ovr_config//os:linux": [
            "bsmr_build//third-party/rust:hyper-util",
            "bsmr_build//third-party/rust:nix",
            "bsmr_build//third-party/rust:tower",
            "bsmr_build//third-party/rust:xattr",
        ],
        "ovr_config//os:macos": [
            "bsmr_build//third-party/rust:hyper-util",
            "bsmr_build//third-party/rust:nix",
            "bsmr_build//third-party/rust:tower",
            "bsmr_build//third-party/rust:xattr",
        ],
    }),
)
