# Defines build targets for app/bsmr_fs.

load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "bsmr_fs",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    autocargo = {
        "cargo_toml_config": {
            "extra_buck_dependencies": {
                "dependencies": [
                    (None, "//common/rust/shed/detect_eden:detect_eden"),
                ],
            },
        },
    },
    test_deps = [
        "bsmr_build//third-party/rust:assert_matches",
        "bsmr_build//third-party/rust:serde_json",
        "bsmr_build//third-party/rust:tempfile",
        "root//app/bsmr_hash:bsmr_hash",
    ],
    deps = [
        "bsmr_build//third-party/rust:compact_str",
        "bsmr_build//third-party/rust:derive_more",
        "bsmr_build//third-party/rust:dunce",
        "bsmr_build//third-party/rust:memchr",
        "bsmr_build//third-party/rust:ref-cast",
        "bsmr_build//third-party/rust:serde",
        "bsmr_build//third-party/rust:smallvec",
        "bsmr_build//third-party/rust:tokio",
        "root//packages/rust/allocative/allocative:allocative",
        "root//app/bsmr_env:bsmr_env",
        "root//app/bsmr_error:bsmr_error",
        "root//app/bsmr_util:bsmr_util",
        "root//packages/rust/gazebo/dupe:dupe",
        "root//packages/rust/gazebo/gazebo:gazebo",
        "root//packages/rust/gazebo/strong_hash:strong_hash",
        "root//packages/rust/pagable/pagable:pagable",
        # @oss-disable[end= ]: "//common/rust/shed/detect_eden:detect_eden",
    ] + select({
        "DEFAULT": [],
        "ovr_config//os:linux": [
            "bsmr_build//third-party/rust:libc",
            "bsmr_build//third-party/rust:nix",
        ],
        "ovr_config//os:macos": [
            "bsmr_build//third-party/rust:libc",
            "bsmr_build//third-party/rust:nix",
        ],
        "ovr_config//os:windows": [
            "bsmr_build//third-party/rust:common-path",
            "bsmr_build//third-party/rust:windows-sys",
        ],
    }),
)
