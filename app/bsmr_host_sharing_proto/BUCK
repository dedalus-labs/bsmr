load("@bsmr_build//rules:rust.bzl", "proto_srcs", "rust_protobuf_library")
load("@bsmr_build//rules:export_files.bzl", "export_file")

oncall("build_infra")

rust_protobuf_library(
    name = "bsmr_host_sharing_proto",
    srcs = glob(["src/**/*.rs"]),
    build_script = "build.rs",
    proto_srcs = ":host_sharing.proto",
    deps = [
        "fbsource//third-party/rust:serde",
        "//bsmr/packages/rust/allocative/allocative:allocative",
    ],
)

proto_srcs(
    name = "host_sharing.proto",
    srcs = ["host_sharing.proto"],
    visibility = ["PUBLIC"],
)

export_file(
    name = "host_sharing_proto",
    src = "host_sharing.proto",
)
