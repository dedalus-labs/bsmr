# Defines build targets for app/bsmr_execute_impl.

load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "bsmr_execute_impl",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    # `root//packages/rust/remote_execution:remote_execution` is an alias selecting between
    # the internal and OSS impls; autocargo doesn't follow aliases, so point at
    # the OSS rust_library directly for cargo's sake.
    autocargo = {
        "cargo_toml_config": {
            "extra_bsmr_dependencies": {
                "dependencies": [
                    "root//packages/rust/remote_execution/oss/re_grpc:remote_execution",
                ],
                "target": {
                    "'cfg(target_os = \"linux\")'": {"dependencies": [(None, "//common/rust/shed/hostcaps:hostcaps")]},
                },
            },
        },
    },
    test_deps = [
        "bsmr_build//third-party/rust:assert_matches",
        "bsmr_build//third-party/rust:sha2",
    ],
    deps = [
        "bsmr_build//third-party/rust:async-condvar-fair",
        "bsmr_build//third-party/rust:async-trait",
        "bsmr_build//third-party/rust:chrono",
        "bsmr_build//third-party/rust:derivative",
        "bsmr_build//third-party/rust:derive_more",
        "bsmr_build//third-party/rust:futures",
        "bsmr_build//third-party/rust:hostname",
        "bsmr_build//third-party/rust:itertools",
        "bsmr_build//third-party/rust:parking_lot",
        "bsmr_build//third-party/rust:pin-project",
        "bsmr_build//third-party/rust:prost",
        "bsmr_build//third-party/rust:regex",
        "bsmr_build//third-party/rust:rusqlite",
        "bsmr_build//third-party/rust:serde_json",
        "bsmr_build//third-party/rust:tar",
        "bsmr_build//third-party/rust:tempfile",
        "bsmr_build//third-party/rust:tokio",
        "bsmr_build//third-party/rust:tokio-retry",
        "bsmr_build//third-party/rust:tokio-stream",
        "bsmr_build//third-party/rust:tonic",
        "bsmr_build//third-party/rust:tracing",
        "bsmr_build//third-party/rust:uuid",
        "bsmr_build//third-party/rust:zstd",
        "root//packages/rust/allocative/allocative:allocative",
        "root//app/bsmr_action_metadata_proto:bsmr_action_metadata_proto",
        "root//app/bsmr_build_signals:bsmr_build_signals",
        "root//app/bsmr_cli_proto:bsmr_cli_proto",
        "root//app/bsmr_common:bsmr_common",
        "root//app/bsmr_core:bsmr_core",
        "root//app/bsmr_data:bsmr_data",
        "root//app/bsmr_directory:bsmr_directory",
        "root//app/bsmr_error:bsmr_error",
        "root//app/bsmr_events:bsmr_events",
        "root//app/bsmr_execute:bsmr_execute",
        "root//app/bsmr_execute_local:bsmr_execute_local",
        "root//app/bsmr_fs:bsmr_fs",
        "root//app/bsmr_hash:bsmr_hash",
        "root//app/bsmr_http:bsmr_http",
        "root//app/bsmr_resource_control:bsmr_resource_control",
        "root//app/bsmr_sandbox:bsmr_sandbox",
        "root//app/bsmr_util:bsmr_util",
        "root//app/bsmr_worker_proto:bsmr_worker_proto",
        "root//app/bsmr_wrapper_common:bsmr_wrapper_common",
        "root//packages/rust/dice/dice_futures:dice_futures",
        "root//packages/rust/gazebo/dupe:dupe",
        "root//packages/rust/gazebo/gazebo:gazebo",
        "root//packages/rust/host_sharing:host_sharing",
        "root//packages/rust/remote_execution:remote_execution",
        "root//packages/rust/starlark/starlark_map:starlark_map",
    ] + select({
        "DEFAULT": [],
        "ovr_config//os:linux": [
            "bsmr_build//third-party/rust:nix",
            "root//app/bsmr_forkserver:bsmr_forkserver",
            "root//app/bsmr_forkserver_proto:bsmr_forkserver_proto",
            # @oss-disable[end= ]: "//common/rust/shed/hostcaps:hostcaps",
            # @oss-disable[end= ]: "//justknobs/rust:justknobs",
        ],
        "ovr_config//os:macos": [
            "bsmr_build//third-party/rust:nix",
            "root//app/bsmr_forkserver:bsmr_forkserver",
            "root//app/bsmr_forkserver_proto:bsmr_forkserver_proto",
        ],
    }),
)
