# Defines build targets for app/bsmr_server_commands.

load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "bsmr_server_commands",
    srcs = glob([
        "src/**/*.rs",
        "src/commands/explain/*",
    ]),
    deps = [
        "bsmr_build//third-party/rust:async-trait",
        "bsmr_build//third-party/rust:chrono",
        "bsmr_build//third-party/rust:futures",
        "bsmr_build//third-party/rust:itertools",
        "bsmr_build//third-party/rust:tokio",
        "bsmr_build//third-party/rust:tokio-stream",
        "bsmr_build//third-party/rust:tonic",
        "bsmr_build//third-party/rust:tracing",
        "root//app/bsmr_artifact:bsmr_artifact",
        "root//app/bsmr_build_api:bsmr_build_api",
        "root//app/bsmr_certs:bsmr_certs",
        "root//app/bsmr_cli_proto:bsmr_cli_proto",
        "root//app/bsmr_common:bsmr_common",
        "root//app/bsmr_core:bsmr_core",
        "root//app/bsmr_data:bsmr_data",
        "root//app/bsmr_directory:bsmr_directory",
        "root//app/bsmr_error:bsmr_error",
        "root//app/bsmr_event_log:bsmr_event_log",
        "root//app/bsmr_event_observer:bsmr_event_observer",
        "root//app/bsmr_events:bsmr_events",
        "root//app/bsmr_execute:bsmr_execute",
        "root//app/bsmr_fs:bsmr_fs",
        "root//app/bsmr_hash:bsmr_hash",
        "root//app/bsmr_install_proto:bsmr_install_proto",
        "root//app/bsmr_interpreter:bsmr_interpreter",
        "root//app/bsmr_node:bsmr_node",
        "root//app/bsmr_query:bsmr_query",
        "root//app/bsmr_server_ctx:bsmr_server_ctx",
        "root//app/bsmr_util:bsmr_util",
        "root//packages/rust/dice/dice:dice",
        "root//packages/rust/gazebo/dupe:dupe",
        "root//packages/rust/starlark/starlark_map:starlark_map",
    ],
)
