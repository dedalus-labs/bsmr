load("@bsmr_build//rules:targets.bzl", "translate_target")

oncall("build_infra")

rust_protobuf_library(
    name = "bsmr_test_proto",
    srcs = glob(["src/**/*.rs"]),
    build_script = "build.rs",
    proto_srcs = ":bsmr_test_proto.proto",
    deps = [
        "bsmr_build//third-party/rust:prost-types",
        "root//app/bsmr_data:bsmr_data",
        "root//app/bsmr_host_sharing_proto:bsmr_host_sharing_proto",
    ],
)

