# Defines build targets for app/bsmr_cli_proto.

load("@bsmr_build//rules:rust.bzl", "proto_srcs", "rust_protobuf_library")
load("@bsmr_build//rules:export_files.bzl", "export_file")
load("@bsmr_build//rules:targets.bzl", "translate_target")

oncall("build_infra")

rust_protobuf_library(
    name = "bsmr_cli_proto",
    srcs = glob(["src/**/*.rs"]),
    build_script = "build.rs",
    proto_srcs = ":bsmr_cli_proto.proto",
    test_deps = [
        "bsmr_build//third-party/rust:futures",
        "bsmr_build//third-party/rust:tokio",
    ],
    deps = [
        "bsmr_build//third-party/rust:bytes",
        "bsmr_build//third-party/rust:prost-types",
        "bsmr_build//third-party/rust:serde",
        "bsmr_build//third-party/rust:tokio-util",
        "root//packages/rust/allocative/allocative:allocative",
        "root//app/bsmr_core:bsmr_core",
        "root//app/bsmr_data:bsmr_data",
        "root//app/bsmr_error:bsmr_error",
        "root//app/bsmr_fs:bsmr_fs",
        "root//app/bsmr_subscription_proto:bsmr_subscription_proto",
    ],
)

proto_srcs(
    name = "bsmr_cli_proto.proto",
    srcs = ["daemon.proto"],
    visibility = ["PUBLIC"],
    deps = [
        translate_target("root//app/bsmr_data:data_proto"),
        translate_target("root//app/bsmr_subscription_proto:bsmr_subscription_proto.proto"),
    ],
)

export_file(
    name = "daemon.proto",
)
