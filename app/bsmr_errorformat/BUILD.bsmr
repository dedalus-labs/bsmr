# Defines build targets for app/bsmr_errorformat.

load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "bsmr_errorformat",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    deps = [
        "bsmr_build//third-party/rust:fancy-regex",
        "bsmr_build//third-party/rust:nom",
        "bsmr_build//third-party/rust:tracing",
        "root//app/bsmr_error:bsmr_error",
    ],
)
