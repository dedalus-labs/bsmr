# Defines build targets for app/bsmr_bxl.

load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "bsmr_bxl",
    srcs = glob(["src/**/*.rs"]),
    test_deps = [
        "bsmr_build//third-party/rust:ctor",
        "bsmr_build//third-party/rust:maplit",
        "root//app/bsmr_interpreter:bsmr_interpreter",
    ],
    deps = [
        "bsmr_build//third-party/rust:anyhow",
        "bsmr_build//third-party/rust:async-recursion",
        "bsmr_build//third-party/rust:async-trait",
        "bsmr_build//third-party/rust:clap",
        "bsmr_build//third-party/rust:derivative",
        "bsmr_build//third-party/rust:derive_more",
        "bsmr_build//third-party/rust:either",
        "bsmr_build//third-party/rust:futures",
        "bsmr_build//third-party/rust:itertools",
        "bsmr_build//third-party/rust:num-bigint",
        "bsmr_build//third-party/rust:serde",
        "bsmr_build//third-party/rust:serde_json",
        "bsmr_build//third-party/rust:tokio",
        "root//packages/rust/allocative/allocative:allocative",
        "root//app/bsmr_action_impl:bsmr_action_impl",
        "root//app/bsmr_analysis:bsmr_analysis",
        "root//app/bsmr_artifact:bsmr_artifact",
        "root//app/bsmr_build_api:bsmr_build_api",
        "root//app/bsmr_cli_proto:bsmr_cli_proto",
        "root//app/bsmr_common:bsmr_common",
        "root//app/bsmr_core:bsmr_core",
        "root//app/bsmr_data:bsmr_data",
        "root//app/bsmr_error:bsmr_error",
        "root//app/bsmr_events:bsmr_events",
        "root//app/bsmr_execute:bsmr_execute",
        "root//app/bsmr_fs:bsmr_fs",
        "root//app/bsmr_hash:bsmr_hash",
        "root//app/bsmr_interpreter:bsmr_interpreter",
        "root//app/bsmr_interpreter_for_build:bsmr_interpreter_for_build",
        "root//app/bsmr_node:bsmr_node",
        "root//app/bsmr_profile:bsmr_profile",
        "root//app/bsmr_query:bsmr_query",
        "root//app/bsmr_query_parser:bsmr_query_parser",
        "root//app/bsmr_server_ctx:bsmr_server_ctx",
        "root//app/bsmr_util:bsmr_util",
        "root//packages/rust/dice/dice:dice",
        "root//packages/rust/dice/dice_futures:dice_futures",
        "root//packages/rust/gazebo/cmp_any:cmp_any",
        "root//packages/rust/gazebo/display_container:display_container",
        "root//packages/rust/gazebo/dupe:dupe",
        "root//packages/rust/gazebo/gazebo:gazebo",
        "root//packages/rust/gazebo/strong_hash:strong_hash",
        "root//packages/rust/pagable/pagable:pagable",
        "root//packages/rust/starlark/starlark:starlark",
        "root//packages/rust/starlark/starlark_map:starlark_map",
    ],
)
