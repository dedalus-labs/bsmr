load("@bsmr_build//rules:rust.bzl", "proto_srcs", "rust_protobuf_library")
load("@bsmr_build//rules:export_files.bzl", "export_file")
load("@bsmr_build//rules:targets.bzl", "translate_target")

oncall("build_infra")

rust_protobuf_library(
    name = "bsmr_data",
    srcs = glob(["src/**/*.rs"]),
    build_script = "build.rs",
    proto_srcs = ":data_proto",
    deps = [
        "bsmr_build//third-party/rust:derive_more",
        "bsmr_build//third-party/rust:hex",
        "bsmr_build//third-party/rust:prost-types",
        "bsmr_build//third-party/rust:serde",
        "root//packages/rust/allocative/allocative:allocative",
        "root//app/bsmr_host_sharing_proto:bsmr_host_sharing_proto",
        "root//packages/rust/gazebo/dupe:dupe",
        "root//packages/rust/gazebo/gazebo:gazebo",
        "root//packages/rust/pagable/pagable:pagable",
    ],
)

proto_srcs(
    name = "data_proto",
    srcs = [
        "data.proto",
        "error.proto",
    ],
    visibility = ["PUBLIC"],
    deps = [
        translate_target("root//app/bsmr_host_sharing_proto:host_sharing.proto"),
    ],
)

export_file(
    name = "error.proto",
)

export_file(
    name = "data.proto",
)
