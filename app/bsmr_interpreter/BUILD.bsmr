# Defines build targets for app/bsmr_interpreter.

load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "bsmr_interpreter",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    test_deps = [
        "bsmr_build//third-party/rust:tempfile",
        "root//app/bsmr_hash:bsmr_hash",
    ],
    deps = [
        "bsmr_build//third-party/rust:async-trait",
        "bsmr_build//third-party/rust:derivative",
        "bsmr_build//third-party/rust:derive_more",
        "bsmr_build//third-party/rust:either",
        "bsmr_build//third-party/rust:fancy-regex",
        "bsmr_build//third-party/rust:itertools",
        "bsmr_build//third-party/rust:plist",
        "bsmr_build//third-party/rust:ref-cast",
        "bsmr_build//third-party/rust:regex",
        "bsmr_build//third-party/rust:serde",
        "bsmr_build//third-party/rust:tokio",
        "bsmr_build//third-party/rust:triomphe",
        "root//packages/rust/allocative/allocative:allocative",
        "root//app/bsmr_common:bsmr_common",
        "root//app/bsmr_core:bsmr_core",
        "root//app/bsmr_error:bsmr_error",
        "root//app/bsmr_events:bsmr_events",
        "root//app/bsmr_fs:bsmr_fs",
        "root//app/bsmr_util:bsmr_util",
        "root//packages/rust/dice/dice:dice",
        "root//packages/rust/dice/dice_futures:dice_futures",
        "root//packages/rust/gazebo/dupe:dupe",
        "root//packages/rust/gazebo/gazebo:gazebo",
        "root//packages/rust/gazebo/strong_hash:strong_hash",
        "root//packages/rust/pagable/pagable:pagable",
        "root//packages/rust/starlark/starlark:starlark",
        "root//packages/rust/starlark/starlark_map:starlark_map",
    ],
)
