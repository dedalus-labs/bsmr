load("@bsmr_build//rules:rust.bzl", "rust_binary")
load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_binary(
    name = "bsmr_miniperf",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    allocator = "malloc",
    allow_cache_upload = True,
    # JEMalloc isn't super lean (and we don't actually allocate anything here),
    # so dont use it.
    default_strip_mode = "full",
    # Must be statically linked because the binary is embedded in the forkserver
    # and written to disk without its shared library dependencies.
    link_style = "static",
    deps = [
        "bsmr_build//third-party/rust:anyhow",
    ] + select({
        # Ideally we'd use compatible_with, but TD does not understand that.
        "DEFAULT": [],
        "ovr_config//os:linux": [
            "bsmr_build//third-party/rust:bincode",
            "bsmr_build//third-party/rust:perf-event",
            "bsmr_build//third-party/rust:smallvec",
            "bsmr_build//third-party/rust:thiserror",
            "root//app/bsmr_miniperf_proto:bsmr_miniperf_proto",
        ],
    }),
)

# TODO
rust_library(
    name = "bsmr_miniperf_test",
    srcs = glob(
        ["test/**/*.rs"],
    ),
    autocargo = {"ignore_rule": True},
    test_deps = select({
        # Ideally we'd use compatible_with, but TD does not understand that.
        "DEFAULT": [],
        "ovr_config//os:linux": [
            "bsmr_build//third-party/rust:anyhow",
            "bsmr_build//third-party/rust:bincode",
            "bsmr_build//third-party/rust:tempfile",
            "root//app/bsmr_miniperf_proto:bsmr_miniperf_proto",
        ],
    }),
    test_env = {
        "MINIPERF": "$(exe_target :bsmr_miniperf)",
        "THREE_BILLION_INSTRUCTIONS": "$(exe_target root//tools/testing/three-billion-instructions:three_billion_instructions-bin)",
    },
)
