# Defines build targets for app/bsmr_events.

load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "bsmr_events",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    autocargo = {
        "cargo_toml_config": {
            "dependencies_override": {
                "dependencies": {
                    "fbinit": {
                        "path": None,
                        "version": "0.2",
                    },
                },
            },
            "extra_bsmr_dependencies": {
                "dependencies": [
                    (None, "//common/rust/shed/hostcaps:hostcaps"),
                ],
            },
        },
    },
    test_deps = ["bsmr_build//third-party/rust:tokio"],
    deps = [
        "bsmr_build//third-party/rust:async-trait",
        "bsmr_build//third-party/rust:console",
        "bsmr_build//third-party/rust:crossbeam-channel",
        "bsmr_build//third-party/rust:derive_more",
        "bsmr_build//third-party/rust:futures",
        "bsmr_build//third-party/rust:hostname",
        "bsmr_build//third-party/rust:is_proc_translated",
        "bsmr_build//third-party/rust:pin-project",
        # @oss-disable[end= ]: "bsmr_build//third-party/rust:prost",
        "bsmr_build//third-party/rust:serde",
        # @oss-disable[end= ]: "bsmr_build//third-party/rust:serde_json",
        "bsmr_build//third-party/rust:smallvec",
        "bsmr_build//third-party/rust:tokio",
        "bsmr_build//third-party/rust:uuid",
        "root//packages/rust/allocative/allocative:allocative",
        "root//app/bsmr_build_info:bsmr_build_info",
        "root//app/bsmr_cli_proto:bsmr_cli_proto",
        "root//app/bsmr_core:bsmr_core",
        "root//app/bsmr_data:bsmr_data",
        "root//app/bsmr_error:bsmr_error",
        "root//app/bsmr_hash:bsmr_hash",
        "root//app/bsmr_util:bsmr_util",
        "root//app/bsmr_wrapper_common:bsmr_wrapper_common",
        "root//packages/rust/gazebo/dupe:dupe",
        "root//packages/rust/gazebo/gazebo:gazebo",
        # @oss-disable[end= ]: "//common/rust/devserver_fingerprint/devserver_fingerprint:devserver_fingerprint",
        "bsmr_build//third-party/rust:fbinit",
        # @oss-disable[end= ]: "//common/rust/shed/hostcaps:hostcaps",
        # @oss-disable[end= ]: "//common/rust/user:user",
        # @oss-disable[end= ]: "//devx_www/cross_env_session_id:cross_env_session_id",
        # @oss-disable[end= ]: "//devx_www/devx_session_id_rust:devx_session_id",
    ] + select({
        "DEFAULT": [],
        "ovr_config//os:linux": [
            "bsmr_build//third-party/rust:sys-info",
        ],
        "ovr_config//os:macos": [
            "bsmr_build//third-party/rust:sys-info",
        ],
        "ovr_config//os:windows": [
            "bsmr_build//third-party/rust:winver",
        ],
    }),
)
