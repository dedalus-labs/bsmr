# Pins Bazel's Python rules, interpreter, and dependency closure.

module(name = "django_benchmark")

bazel_dep(name = "rules_python", version = "2.2.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.14")
use_repo(python, "python_3_14")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "django_pip",
    python_version = "3.14",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "django_pip")
