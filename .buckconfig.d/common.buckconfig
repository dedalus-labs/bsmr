[cells]
prelude = prelude
none = none

[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = char_build
fbcode_macros = char_build
fbsource = char_build
toolchains = char_build

[external_cells]
prelude = disabled

[build]
execution_platforms = prelude//platforms:default

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default target:char_build//...->prelude//platforms:default
