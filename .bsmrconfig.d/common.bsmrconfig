[cells]
prelude = prelude
none = none

[cell_aliases]
config = prelude
ovr_config = prelude
toolchains = bsmr_build
# Optional targets retained by the upstream prelude resolve to a disabled cell.
upstream = none

[external_cells]
prelude = disabled

[build]
execution_platforms = prelude//platforms:default

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default target:bsmr_build//...->prelude//platforms:default
