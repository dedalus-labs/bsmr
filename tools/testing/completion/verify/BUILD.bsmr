# Defines build targets for tools/testing/completion/verify.

load("@bsmr_build//rules:rust.bzl", "rust_binary")

oncall("build_infra")

# Small binary to verify shell completion works correctly. Used in e2e tests of bsmr.
rust_binary(
    name = "completion_verify",
    srcs = glob(["src/**/*.rs"]),
    compatible_with = [
        "ovr_config//os:linux",
        "ovr_config//os:macos",
    ],
    resources = select({
        "DEFAULT": {},
        "ovr_config//os:linux": {
            "fish": "root//tools/testing/completion/verify/packages:fish",
            "zsh": "root//tools/testing/completion/verify/packages:zsh",
        },
    }),
    deps = [
        "root//packages/rust/bsmr-resources:bsmr_resources",
        "bsmr_build//third-party/rust:clap",
        "bsmr_build//third-party/rust:ptyprocess",
        "bsmr_build//third-party/rust:tempfile",
        "bsmr_build//third-party/rust:vt100",
    ] + select({
        "DEFAULT": [],
        "ovr_config//os:linux": ["bsmr_build//third-party/rust:nix"],
        "ovr_config//os:macos": ["bsmr_build//third-party/rust:nix"],
    }),
)
