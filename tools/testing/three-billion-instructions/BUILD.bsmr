load("@bsmr_build//rules:rust.bzl", "rust_binary")
load("@bsmr_build//rules:rust.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "three_billion_instructions",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    deps = [
        "bsmr_build//third-party/rust:thiserror",
    ],
)

rust_binary(
    name = "three_billion_instructions-bin",
    srcs = ["bin/three_billion_instructions.rs"],
    crate_root = "bin/three_billion_instructions.rs",
    deps = [
        ":three_billion_instructions",
    ],
)
