[buildfile]
# see <https://github.com/facebook/buck2/pull/956> -- this helps us make
# error messages when the user doesn't run "reindeer" much more obvious,
# because the default BUCK file just errors out. We then make reindeer generate
# BUCK.reindeer to override that.
name = BUCK.reindeer,BUCK

[cells]
bsmr_build = .

[cell_aliases]
root = bsmr_build

# A cell reads its own configuration, so repeat the aliases that its build
# support files use.
[cells]
prelude = prelude
none = none

[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = bsmr_build
fbcode_macros = bsmr_build
fbsource = bsmr_build
toolchains = bsmr_build

[external_cells]
prelude = disabled

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default target:bsmr_build//...->prelude//platforms:default
