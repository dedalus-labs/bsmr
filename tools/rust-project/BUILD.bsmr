# Defines build targets for tools/rust-project.

load("@bsmr_build//rules:rust.bzl", "rust_binary")

rust_binary(
    name = "rust-project",
    srcs = glob([
        "src/**/*.rs",
        "templates/*",
    ]),
    crate_root = "src/main.rs",
    link_style = "static",
    deps = [
        "bsmr_build//third-party/rust:anyhow",
        "bsmr_build//third-party/rust:clap",
        "bsmr_build//third-party/rust:dunce",
        "bsmr_build//third-party/rust:elf",
        "bsmr_build//third-party/rust:rustc-hash",
        "bsmr_build//third-party/rust:serde",
        "bsmr_build//third-party/rust:serde_json",
        "bsmr_build//third-party/rust:serde_path_to_error",
        "bsmr_build//third-party/rust:tracing",
        "bsmr_build//third-party/rust:tracing-subscriber",
    ],
)
