# Defines build targets for docs/bsmr_lab/greeter_bin.

# @oss-disable[end= ]: load("@bsmr_build//rules:rust.bzl", "rust_binary")

oncall("build_infra")

rust_binary(
    name = "main",
    srcs = ["src/main.rs"],
    deps = [
        "root//docs/bsmr_lab/greeter_lib:library",
        "root//docs/bsmr_lab/logging_lib:logging_lib",
    ],
)
